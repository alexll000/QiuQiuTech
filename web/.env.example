NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
NEXT_PUBLIC_USE_DIRECTUS=true

# Directus 写入链路鉴权（保存草稿/申请合作/收藏/通知等需要）
# 如果你希望用静态 token，可只设置 DIRECTUS_STATIC_TOKEN，其他字段可留空
DIRECTUS_STATIC_TOKEN=
DIRECTUS_ADMIN_EMAIL=admin@qiuqiutech.com
DIRECTUS_ADMIN_PASSWORD=ChangeThisAdminPassword123!

# 当前前台“写入用户”占位（当前项目还没接入真实登录态）
QIUQIUTECH_CURRENT_USER_ID=me
